@model DuongQuangHuy_241230742.Models.Sach

<div class="section-head">
    <h3>Dương Quang Huy - THÊM SÁCH MỚI</h3>
</div>

<div style="background:#fff; padding:24px; border-radius:8px; max-width:450px; box-shadow:0 1px 4px rgba(0,0,0,.1);">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color:red; margin-bottom:10px;"></div>

        <div style="margin-bottom:14px;">
            <label asp-for="MaTl" style="display:block; font-weight:600; margin-bottom:4px;">MaTL</label>
            <select asp-for="MaTl" asp-items="ViewBag.MaTl" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;"></select>
        </div>

        <div style="margin-bottom:14px;">
            <label asp-for="TenSach" style="display:block; font-weight:600; margin-bottom:4px;">TenSach</label>
            <input asp-for="TenSach" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;" />
            <span asp-validation-for="TenSach" style="color:red; font-size:13px;"></span>
        </div>

        <div style="margin-bottom:14px;">
            <label asp-for="Gia" style="display:block; font-weight:600; margin-bottom:4px;">Gia</label>
            <input asp-for="Gia" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;" />
            <span asp-validation-for="Gia" style="color:red; font-size:13px;"></span>
        </div>

        <div style="margin-bottom:18px;">
            <label asp-for="Anh" style="display:block; font-weight:600; margin-bottom:4px;">Anh</label>
            <input asp-for="Anh" placeholder="Ví dụ: Img_1.jpg" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;" />
            <span asp-validation-for="Anh" style="color:red; font-size:13px;"></span>
        </div>

        <button type="submit" class="btn-buy" style="padding:10px 20px; font-size:14px;">Create</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}