<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BookHub - Nhà sách trực tuyến</title>
    <link href="~/css/layout.css" rel="stylesheet" type="text/css" />
    <link href="~/css/style.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <partial name="DuongQuangHuy_Header"/>
    <main class="main"> 
        <div class="container">
            @RenderBody()
        </div>
    </main>
    <partial name="DuongQuangHuy_Footer" />
    <div class="to-top"> &uarr;</div>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/main.js"></script>
    <script>
            $(document).ready(function () {
                $('.menu-theloai').click(function (e) {
                    e.preventDefault();

                    $('.menu li').removeClass('active');
                    $(this).parent('li').addClass('active');

                    var maTl = $(this).data('id');

                    $.ajax({
                        url: '/Home/LocSachTheoTheLoai',
                        type: 'GET',
                        data: { maTl: maTl },
                        success: function (response) {
                            $('#main-content').html(response);
                        },
                        error: function () {
                            alert('Không thể tải dữ liệu sách!');
                        }
                    });
                });
            });
    </script>
    @await RenderSectionAsync("Scripts", required:false)
</body>
</html>
